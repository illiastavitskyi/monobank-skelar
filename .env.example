GEMINI_API_KEY=your_gemini_api_key_here
IMAGE_BASE_URL=https://link/<uuid>

# LLM provider: gemini | mock
LLM_PROVIDER=gemini

# RAG backend — all use Qdrant, all require Docker:
#   tfidf   → BM25 sparse vectors (fast, keyword-based, no neural model)
#   qdrant  → dense semantic embeddings (multilingual, ~10min first index)
#   hybrid  → BM25 + dense fused with RRF (best quality, ~10min first index)
RAG_BACKEND=tfidf

# Qdrant (only needed when RAG_BACKEND=qdrant)
# docker run -p 6333:6333 -v qdrant_storage:/qdrant/storage qdrant/qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=listings
